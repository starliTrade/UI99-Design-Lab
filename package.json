{
  "name": "liminal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "node --require ./scripts/eslint-ts6-shim.cjs node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --require ./scripts/eslint-ts6-shim.cjs node_modules/eslint/bin/eslint.js . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run build && bun run build:lib && bun run verify:package",
    "audit:tokens": "node scripts/token-audit.mjs",
    "gen:css": "bun scripts/gen-css-vars.ts",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "verify:package": "node scripts/verify-package.mjs",
    "gen:api": "bun scripts/gen-api.ts",
    "gen:policy": "bun scripts/gen-policy-md.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "css-tree": "3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "typescript6": "npm:typescript@^6",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/liminal.js",
      "require": "./dist-lib/liminal.cjs"
    },
    "./styles.css": "./dist-lib/liminal.css",
    "./package.json": "./package.json"
  },
  "types": "./dist-lib/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "description": "A dark UI engine: every surface, edge, colour and space comes from a rule, and the rule is written as a test.",
  "license": "MIT",
  "keywords": [
    "design-system",
    "react",
    "oklch",
    "dark-ui",
    "rtl",
    "accessibility",
    "design-tokens"
  ]
}
